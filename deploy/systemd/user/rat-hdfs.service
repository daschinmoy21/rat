[Unit]
Description=rat HDFS (single-node NameNode + DataNode via podman-compose)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/rat
ExecStart=%h/rat/scripts/run-in-nix.sh podman-compose -f infra/hadoop/compose.yml up -d
ExecStop=%h/rat/scripts/run-in-nix.sh podman-compose -f infra/hadoop/compose.yml down

[Install]
WantedBy=default.target
