[Unit]
Description=rat producers (plugin sources -> Kafka or Iggy, per RAT_BROKER)
# Broker-neutral: install.sh enables the broker unit matching RAT_BROKER in
# ~/.config/rat/env (kafka by default, iggy for the Rust stack).
After=rat-kafka.service rat-iggy.service network-online.target

[Service]
EnvironmentFile=-%h/.config/rat/env
Environment=RAT_CURSOR_DB=%h/.local/state/rat/cursors.db
# make-topics.sh dispatches on RAT_BROKER (iggy: `rat topics --wait`).
ExecStartPre=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; cd "$$ROOT" && exec "$$ROOT/scripts/run-in-nix.sh" "$$ROOT/scripts/make-topics.sh"'
ExecStart=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; cd "$$ROOT" && exec "$$ROOT/scripts/run-in-nix.sh" uv run rat run'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
