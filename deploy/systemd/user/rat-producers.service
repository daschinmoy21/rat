[Unit]
Description=rat producers (plugin sources -> Kafka)
Wants=rat-kafka.service
After=rat-kafka.service network-online.target

[Service]
EnvironmentFile=-%h/.config/rat/env
Environment=RAT_CURSOR_DB=%h/.local/state/rat/cursors.db
ExecStartPre=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; cd "$$ROOT" && exec "$$ROOT/scripts/run-in-nix.sh" "$$ROOT/scripts/make-topics.sh"'
ExecStart=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; cd "$$ROOT" && exec "$$ROOT/scripts/run-in-nix.sh" uv run rat run'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
