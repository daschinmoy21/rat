[Unit]
Description=rat hive metastore (thrift, standalone Derby)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/rat
ExecStart=%h/rat/scripts/run-in-nix.sh podman-compose -f infra/hive-metastore/compose.yml up -d
ExecStop=%h/rat/scripts/run-in-nix.sh podman-compose -f infra/hive-metastore/compose.yml down

[Install]
WantedBy=default.target
