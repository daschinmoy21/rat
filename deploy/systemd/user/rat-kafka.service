[Unit]
Description=rat kafka broker (single-node KRaft via podman-compose)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/rat
ExecStart=%h/rat/scripts/run-in-nix.sh podman-compose -f infra/kafka/compose.yml up -d
ExecStop=%h/rat/scripts/run-in-nix.sh podman-compose -f infra/kafka/compose.yml down

[Install]
WantedBy=default.target
