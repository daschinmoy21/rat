[Unit]
Description=rat kafka broker (single-node KRaft via podman-compose)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-%h/.config/rat/env
ExecStart=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; exec "$$ROOT/scripts/run-in-nix.sh" podman-compose -f "$$ROOT/infra/kafka/compose.yml" up -d'
ExecStop=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; exec "$$ROOT/scripts/run-in-nix.sh" podman-compose -f "$$ROOT/infra/kafka/compose.yml" down'

[Install]
WantedBy=default.target
