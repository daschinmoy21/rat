[Unit]
Description=rat Hive (metastore thrift :9083 + HiveServer2 :10000, host network)
Wants=rat-hdfs.service
After=rat-hdfs.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-%h/.config/rat/env
ExecStart=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; exec "$$ROOT/scripts/run-in-nix.sh" podman-compose -f "$$ROOT/infra/hive/compose.yml" up -d'
ExecStop=/bin/sh -c 'ROOT="$${RAT_ROOT:-%h/rat}"; exec "$$ROOT/scripts/run-in-nix.sh" podman-compose -f "$$ROOT/infra/hive/compose.yml" down'

[Install]
WantedBy=default.target
