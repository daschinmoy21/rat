{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["symbol", "price"],
  "properties": {
    "symbol": { "type": "string" },
    "price": { "type": "number" },
    "currency": { "type": "string" },
    "change": { "type": "number" },
    "volume": { "type": "integer" }
  },
  "additionalProperties": true
}
