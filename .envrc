# Nix flake when Nix is here. mise.toml when it is not.
if has nix && [ -f flake.nix ]; then
  use flake
elif has mise && [ -f mise.toml ]; then
  eval "$(mise activate bash direnv)"
fi

watch_file pyproject.toml
watch_file uv.lock
watch_file producers/pyproject.toml
watch_file mise.toml

# Non-Nix shells do not run the flake shellHook, so sync here.
if has uv && [ -f pyproject.toml ]; then
  if [ ! -d .venv ]; then
    uv sync --frozen || uv sync
  fi
fi

if [ -d .venv/bin ]; then
  PATH_add .venv/bin
  export VIRTUAL_ENV="$PWD/.venv"
fi
